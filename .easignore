# Keep production EAS archives free of local configuration, secrets, test data,
# caches, and migration inputs. Required production values are provided through
# the deployment environment rather than committed source files.
.git/
.emergent/
node_modules/
frontend/node_modules/
backend/.env
frontend/.env
.env
.env.*
!.env.example
memory/test_credentials.md
*.jsonl
__pycache__/
**/__pycache__/
.ruff_cache/
**/.ruff_cache/
.cache/
frontend/.metro-cache/
frontend/.expo/
frontend/dist/
frontend/web-build/
test_reports/
*.pyc
*.pyo