{
  "expo": {
    "name": "MSafe Legal Aid",
    "slug": "msafe-legal-aid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "msafelegalaid",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.msafesolutions.legalaid",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Speak your legal questions in your language",
        "NSSpeechRecognitionUsageDescription": "Convert your spoken legal questions into text on-device",
        "NSCameraUsageDescription": "Attach photos to your missing-person complaint",
        "NSPhotoLibraryUsageDescription": "Choose photos for your missing-person complaint",
        "NSLocationWhenInUseUsageDescription": "Add a confirmed last-seen location to complaints"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1A3F74"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.msafesolutions.legalaid",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/dhara_logo_full.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#1A3F74"
        }
      ],
      "expo-web-browser",
      "expo-speech-recognition",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1A3F74",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
